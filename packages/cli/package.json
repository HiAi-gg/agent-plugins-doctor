{
  "name": "@agent-plugins-doctor/cli",
  "version": "0.0.6",
  "description": "Command-line interface for Agent Plugin Doctor",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "agent-plugins-doctor": "./dist/bin.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/HiAi-gg/agent-plugins-doctor.git",
    "directory": "packages/cli"
  },
  "bugs": "https://github.com/HiAi-gg/agent-plugins-doctor/issues",
  "homepage": "https://github.com/HiAi-gg/agent-plugins-doctor#readme",
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "bun build ./src/index.ts ./src/bin.ts --outdir ./dist --target node && tsc --emitDeclarationOnly --declaration --outDir ./dist --rootDir ./src --target ES2022 --module ES2022 --moduleResolution bundler --esModuleInterop --resolveJsonModule --skipLibCheck --strict src/index.ts src/bin.ts && cp ../../LICENSE ./dist/LICENSE && cp ../../README.md ./dist/README.md",
    "clean": "rm -rf dist",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@agent-plugins-doctor/core": "^0.0.6",
    "@agent-plugins-doctor/parser": "^0.0.6",
    "@agent-plugins-doctor/rules": "^0.0.6",
    "@agent-plugins-doctor/compatibility": "^0.0.6",
    "@agent-plugins-doctor/report": "^0.0.6",
    "commander": "^13.0.0",
    "chalk": "^5.4.0"
  },
  "devDependencies": {
    "typescript": "^5.9.0"
  }
}
