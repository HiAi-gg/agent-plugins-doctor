{
  "name": "agent-plugins-doctor",
  "version": "0.0.4",
  "description": "Diagnose and fix Agent Plugins",
  "keywords": [
    "agent-plugins",
    "validation",
    "diagnostics",
    "security",
    "compatibility",
    "mcp",
    "agent-skills"
  ],
  "license": "MIT",
  "author": "HiAI",
  "repository": {
    "type": "git",
    "url": "https://github.com/HiAi-gg/agent-plugins-doctor.git"
  },
  "bugs": {
    "url": "https://github.com/HiAi-gg/agent-plugins-doctor/issues"
  },
  "homepage": "https://github.com/HiAi-gg/agent-plugins-doctor#readme",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "bunx --bun eslint .",
    "test": "bun test --pass-with-no-tests",
    "build": "bun run --filter '*' build",
    "clean": "bun run --filter '*' clean",
    "check:versions": "bun run scripts/check-version-integrity.ts",
    "publish:dry-run": "bun run scripts/publish.ts --dry-run",
    "publish:all": "bun run scripts/publish.ts",
    "publish:npm:dry-run": "cd packages/npm && npm publish --dry-run",
    "publish:npm": "cd packages/npm && npm publish"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "typescript": "^5.9.0",
    "eslint": "^9.0.0",
    "@eslint/js": "^9.0.0",
    "typescript-eslint": "^8.0.0",
    "@agent-plugins-doctor/core": "workspace:*",
    "@agent-plugins-doctor/parser": "workspace:*",
    "@agent-plugins-doctor/rules": "workspace:*",
    "@agent-plugins-doctor/report": "workspace:*",
    "@agent-plugins-doctor/compatibility": "workspace:*",
    "@agent-plugins-doctor/cli": "workspace:*"
  }
}
